---
interface Props {
	text: string;
	label?: string;
}

const { text, label = '复制' } = Astro.props;
---

<button
	type="button"
	class="inline-flex items-center rounded border border-neutral-300 px-2 py-1 text-sm text-neutral-700 hover:bg-neutral-100"
	data-copy-text={text}
	data-copy-label-default={label}
	data-copy-label-success="已复制"
>
	{label}
</button>

<script>
	const boundAttr = 'data-quips-copy-bound';
	if (!document.documentElement.hasAttribute(boundAttr)) {
		document.documentElement.setAttribute(boundAttr, 'true');
		document.addEventListener('click', async (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const button = target.closest('[data-copy-text]');
			if (!(button instanceof HTMLButtonElement)) return;

			const text = button.dataset.copyText ?? '';
			const defaultLabel = button.dataset.copyLabelDefault ?? '复制';
			const successLabel = button.dataset.copyLabelSuccess ?? '已复制';
			const original = button.textContent ?? defaultLabel;

			if (!text) return;

			try {
				await navigator.clipboard.writeText(text);
				button.textContent = successLabel;
			} catch {
				button.textContent = '复制失败';
			}

			window.setTimeout(() => {
				button.textContent = original;
			}, 1200);
		});
	}
</script>

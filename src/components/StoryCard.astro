---
import CopyButton from './CopyButton.astro';

interface Props {
	number?: number;
	title: string;
	text: string;
}

const { number, title, text } = Astro.props;
const copyText = `${title}\n${text}`;
---

<article class="rounded-lg border border-neutral-200 bg-white p-4 shadow-sm">
	<header class="mb-2 flex items-start justify-between gap-3">
		<h2 class="m-0 text-lg font-semibold text-neutral-900">
			{number ? `${number}. ` : ''}{title}
		</h2>
		<CopyButton text={copyText} />
	</header>
	<p class="m-0 whitespace-pre-wrap leading-8 text-neutral-800">{text}</p>
</article>
